    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #eef2f7; font-family: 'Inter', sans-serif;
            display: flex; justify-content: center; align-items: center;
            min-height: 100vh; padding: 24px;
        }
        .dashboard {
            max-width: 1400px; width: 100%; background: #ffffff;
            border-radius: 36px; padding: 40px 44px 44px;
            box-shadow: 0 20px 60px rgba(0,20,40,0.08);
            border: 1px solid #e6edf4;
        }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px; }
        .header-left { display: flex; align-items: center; gap: 18px; }
        .header-left .logo-dr { height: 44px; width: auto; }
        .header-left .divider { width: 1px; height: 32px; background: #d0d9e6; }
        .header-left .title-group .main-title { font-size: 22px; font-weight: 800; color: #0b1a33; letter-spacing: -0.3px; }
        .header-left .title-group .sub-title { font-size: 13px; font-weight: 500; color: #5a6f8c; }
        .tab-bar { display: flex; gap: 6px; background: #f0f4fb; border-radius: 18px; padding: 5px; margin-bottom: 32px; border: 1px solid #dce3ed; flex-wrap: wrap; }
        .tab-btn {
            flex: 1; padding: 12px 20px; border: none; background: transparent;
            border-radius: 14px; font-size: 15px; font-weight: 600; color: #5a6f8c;
            cursor: pointer; transition: 0.25s ease; display: flex;
            align-items: center; justify-content: center; gap: 10px; font-family: 'Inter', sans-serif;
            white-space: nowrap;
        }
        .tab-btn i { font-size: 18px; }
        .tab-btn:hover { color: #0b1a33; background: rgba(255,255,255,0.5); }
        .tab-btn.active { background: #ffffff; color: #0b1a33; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
        .tab-content { display: none; }
        .tab-content.active { display: block; }

        .comparison-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-top: 8px; }
        .funnel-panel {
            background: #fafcff; border-radius: 24px; padding: 20px 20px 24px;
            border: 1px solid #e6edf4; box-shadow: 0 2px 8px rgba(0,20,40,0.04);
        }
        .funnel-panel .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px; }
        .funnel-panel .panel-title { font-size: 16px; font-weight: 700; color: #0b1a33; display: flex; align-items: center; gap: 8px; }
        .funnel-panel .panel-title i { color: #3b82f6; }
        .funnel-panel .panel-selector input[type="month"] {
            background: #ffffff; border: 1px solid #d0d9e6; border-radius: 100px;
            padding: 6px 14px; font-family: 'Inter', sans-serif; font-size: 13px;
            font-weight: 600; color: #0b1a33; outline: none; cursor: pointer; transition: 0.2s;
        }
        .funnel-panel .panel-selector input[type="month"]:hover { border-color: #3b82f6; }
        .funnel-panel .panel-selector input[type="month"]:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.15); }

        .funnel-panel .funnel { display: flex; flex-direction: column; gap: 10px; }
        .funnel-step {
            display: flex; align-items: center; gap: 20px; background: #f8fafc;
            border-radius: 18px; padding: 14px 20px; border: 1px solid #e6edf4;
            transition: 0.25s ease; box-shadow: 0 2px 6px rgba(0,20,40,0.04);
        }
        .funnel-step:hover { background: #f1f5f9; border-color: #b8c9dd; box-shadow: 0 4px 12px rgba(0,20,40,0.06); }

        .funnel-step:nth-child(1) { width: 100%; margin-left: 0; }
        .funnel-step:nth-child(2) { width: 92%; margin-left: 4%; }
        .funnel-step:nth-child(3) { width: 84%; margin-left: 8%; }
        .funnel-step:nth-child(4) { width: 76%; margin-left: 12%; }
        .funnel-step:nth-child(5) { width: 68%; margin-left: 16%; }
        .funnel-step:nth-child(6) { width: 60%; margin-left: 20%; }

        .funnel-step.voice-step:nth-child(1) { width: 100%; margin-left: 0; cursor: pointer; flex-direction: column; align-items: stretch; }
        .funnel-step.voice-step:nth-child(1):hover { background: #e0f2fe; border-color: #3b82f6; box-shadow: 0 4px 12px rgba(59,130,246,0.15); }
        .funnel-step.voice-step:nth-child(2) { width: 94%; margin-left: 3%; }
        .funnel-step.voice-step:nth-child(3) { width: 88%; margin-left: 6%; }
        .funnel-step.voice-step:nth-child(4) { width: 82%; margin-left: 9%; }
        .funnel-step.voice-step:nth-child(5) { width: 76%; margin-left: 12%; }
        .funnel-step.voice-step:nth-child(6) { width: 70%; margin-left: 15%; }
        .funnel-step.voice-step:nth-child(7) { width: 64%; margin-left: 18%; }

        .funnel-step.site-step:nth-child(1) { width: 100%; margin-left: 0; }
        .funnel-step.site-step:nth-child(2) { width: 94%; margin-left: 3%; }
        .funnel-step.site-step:nth-child(3) { width: 88%; margin-left: 6%; flex-direction: column; align-items: stretch; }
        .funnel-step.site-step:nth-child(4) { width: 82%; margin-left: 9%; }
        .funnel-step.site-step:nth-child(5) { width: 76%; margin-left: 12%; }
        .funnel-step.site-step:nth-child(6) { width: 70%; margin-left: 15%; }
        .funnel-step.site-step:nth-child(7) { width: 64%; margin-left: 18%; }

        .funnel-step.clinica-step,
        .funnel-step.clinica-total { width: 100%; margin-left: 0; }

        .funnel-step .step-main { display: flex; align-items: center; gap: 20px; width: 100%; }
        .funnel-step .step-icon { flex-shrink: 0; }
        .funnel-step .step-info { flex: 1; }
        .funnel-step .step-label { font-weight: 600; font-size: 15px; color: #0b1a33; }

        /* ✅ Badge "TP" (Tráfego Pago) */
        .funnel-step .step-label .badge-tp {
            display: inline-block;
            font-size: 10px;
            font-weight: 700;
            background: #fef3c7;
            color: #92400e;
            border: 1px solid #fcd34d;
            padding: 1px 7px;
            border-radius: 100px;
            margin-left: 6px;
            vertical-align: middle;
            letter-spacing: 0.4px;
            cursor: help;
            text-transform: uppercase;
        }

        .funnel-step .step-value { font-weight: 800; font-size: 24px; color: #0b1a33; letter-spacing: -0.5px; }
        .funnel-step .step-value small { font-weight: 400; font-size: 14px; color: #5a6f8c; margin-left: 4px; }
        .funnel-step .step-percent { font-size: 13px; font-weight: 600; color: #475569; background: #eef2f7; padding: 2px 14px; border-radius: 100px; border: 1px solid #d0d9e6; display: inline-block; margin-top: 4px; }
        .funnel-step .step-split { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 4px; }
        .funnel-step .step-split-item { display: flex; align-items: baseline; gap: 6px; background: #f1f5f9; padding: 4px 12px; border-radius: 100px; border: 1px solid #d0d9e6; }
        .funnel-step .step-split-item .label { font-weight: 500; font-size: 13px; color: #475569; }
        .funnel-step .step-split-item .value { font-weight: 700; font-size: 16px; color: #0b1a33; }
        .funnel-step .step-bar { width: 100%; height: 6px; background: #e6edf4; border-radius: 99px; overflow: hidden; margin-top: 6px; }
        .funnel-step .step-bar .bar-fill { height: 100%; border-radius: 99px; transition: width 0.6s ease; }
        .funnel-step .click-hint { font-size: 11px; color: #3b82f6; font-weight: 500; margin-top: 2px; display: flex; align-items: center; gap: 4px; }

        .substeps-inline {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 6px 18px;
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px dashed #d0d9e6;
            font-size: 13px;
            color: #475569;
        }
        .substeps-inline .substep-item { display: inline-flex; align-items: baseline; gap: 6px; }
        .substeps-inline .substep-item .substep-label { font-weight: 500; color: #64748b; }
        .substeps-inline .substep-item .substep-value { font-weight: 700; color: #0b1a33; font-size: 14px; }
        .substeps-inline .substep-item .substep-percent { font-size: 11.5px; color: #94a3b8; }
        .substeps-inline .substep-sep { color: #cbd5e1; font-size: 12px; }

        .chamadas-detalhes { display: none; margin-top: 12px; padding-top: 12px; border-top: 2px dashed #d0d9e6; gap: 10px; flex-direction: column; }
        .chamadas-detalhes.open { display: flex; }
        .chamadas-detalhes .detalhe-item {
            display: flex; justify-content: space-between; align-items: center;
            background: #ffffff; padding: 10px 16px; border-radius: 12px; border: 1px solid #e6edf4;
        }
        .chamadas-detalhes .detalhe-item .label { font-weight: 500; color: #475569; font-size: 14px; display: flex; align-items: center; gap: 8px; }
        .chamadas-detalhes .detalhe-item .label i { color: #3b82f6; width: 18px; }
        .chamadas-detalhes .detalhe-item .value { font-weight: 700; font-size: 18px; color: #0b1a33; }

        .bar-fill.blue { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
        .bar-fill.purple { background: linear-gradient(90deg, #8b5cf6, #a78bfa); }
        .bar-fill.teal { background: linear-gradient(90deg, #0d9488, #2dd4bf); }
        .bar-fill.green { background: linear-gradient(90deg, #059669, #34d399); }
        .bar-fill.amber { background: linear-gradient(90deg, #d97706, #fbbf24); }
        .bar-fill.red { background: linear-gradient(90deg, #dc2626, #f87171); }
