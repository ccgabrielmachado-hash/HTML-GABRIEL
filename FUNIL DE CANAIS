  <!-- ============================================================
  BLOCO: JAVASCRIPT
  ============================================================ -->
  <script>
    // ================================================================
    // PASSO 1: DEFINA AQUI TODAS AS RÉGUAS (MENU)
    // Para adicionar uma nova régua, copie um objeto e ajuste os valores.
    // O 'id' deve ser único e deve corresponder ao ID da <div> da página.
    // ================================================================
    const REGULAS = [
      // --- Dashboard (sempre presente) ---
      { id: 'visao-geral', titulo: 'Visão Geral', categoria: 'Dashboard', icone: '🏠', status: '' },

      // --- Atração & Cadastro ---
      { id: 'email-boas-vindas', titulo: 'E-mail: Boas-vindas', categoria: 'Atração & Cadastro', icone: '📧', status: 'D+0' },

      // --- Jornada Agendamento ---
      { id: 'email-pre', titulo: '1. Pré-Consulta', categoria: 'Jornada Agendamento', icone: '📧', status: 'Imed.' },
      { id: 'whats-confirma', titulo: '2. Confirmação', categoria: 'Jornada Agendamento', icone: '💬', status: 'Dia 0' },
      { id: 'email-pos', titulo: '3. Pós-Consulta', categoria: 'Jornada Agendamento', icone: '📧', status: 'IMED' },
      { id: 'pos-consulta-orcamento', titulo: '4. Pós-Consulta Orçamento', categoria: 'Jornada Agendamento', icone: '📧', status: '+2h' },
      { id: 'pos-consulta-emagrecimento', titulo: '5. Pós-Consulta Emagrecimento', categoria: 'Jornada Agendamento', icone: '📧', status: 'IMED' },
      { id: 'pos-consulta-prontoatend', titulo: '6. Pós-Consulta pronto-atendimento', categoria: 'Jornada Agendamento', icone: '📧', status: 'IMED' },
      // Exemplo de como adicionar uma nova régua na Jornada Agendamento:
      // { id: 'nova-regua', titulo: '4. Pós-Consulta Orçamento', categoria: 'Jornada Agendamento', icone: '📧', status: 'D+2h' },

      // --- Réguas Clínicas ---
      { id: 'no-show', titulo: 'No Show', categoria: 'Réguas Clínicas', icone: '📅', status: '+3H' },
    { id: 'fluor-aniversariantes', titulo: 'Fluor Aniversariante', categoria: 'Réguas Clínicas', icone: '💬', status: 'D+2' },
      { id: 'cancelados', titulo: 'Cancelados', categoria: 'Réguas Clínicas', icone: '❌', status: 'D+1' },

      // --- Campanhas Ativas ---
      { id: 'campanha-mes', titulo: 'Campanha do Mês', categoria: 'Campanhas Ativas', icone: '📢', status: 'Massa' }
    ];

    // ================================================================
    // PASSO 2: GERAR O MENU DINAMICAMENTE
    // ================================================================
    function gerarMenu() {
      const container = document.getElementById('menu-container');
      if (!container) return;

      // Agrupar por categoria
      const categorias = {};
      REGULAS.forEach(r => {
        if (!categorias[r.categoria]) categorias[r.categoria] = [];
        categorias[r.categoria].push(r);
      });

      let html = '';
      for (const [cat, itens] of Object.entries(categorias)) {
        html += `<div class="menu-category">${cat}</div>`;
        itens.forEach(item => {
          const statusClass = item.status ? `status-rodando` : '';
          const statusLabel = item.status ? item.status : '';
          // Ícone e título
          const label = `${item.icone} ${item.titulo}`;
          html += `
            <div class="menu-item ${item.id === 'visao-geral' ? 'active' : ''}" 
                 onclick="switchPage('pagina-${item.id}', this)">
              ${label}
              ${statusLabel ? `<span class="status-dot ${statusClass}">${statusLabel}</span>` : ''}
            </div>
          `;
        });
      }

      container.innerHTML = html;
    }

    // ================================================================
    // PASSO 3: FUNÇÃO DE NAVEGAÇÃO
    // ================================================================
    function switchPage(pageId, element) {
      // Esconde todas as páginas
      document.querySelectorAll('.page-content').forEach(p => p.classList.remove('active'));
      // Remove active de todos os itens do menu
      document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('active'));

      // Ativa a página correspondente
      const target = document.getElementById(pageId);
      if (target) target.classList.add('active');

      // Ativa o item do menu clicado
      if (element) element.classList.add('active');
    }

    // ================================================================
    // PASSO 4: INICIALIZAR
    // ================================================================
    document.addEventListener('DOMContentLoaded', () => {
      gerarMenu();
      // Garantir que a página inicial (Visão Geral) esteja ativa
      const paginaInicial = document.getElementById('pagina-visao-geral');
      if (paginaInicial) paginaInicial.classList.add('active');
    });

    // ================================================================
    // COMO ADICIONAR UMA NOVA RÉGUA (INSTRUÇÕES RESUMIDAS):
    // 1. No array REGULAS acima, adicione um novo objeto com os campos:
    //    { id: 'minha-regua', titulo: 'Minha Régua', categoria: 'Jornada Agendamento', icone: '📧', status: '+2h' }
    // 2. No HTML, dentro da <div class="content-body">, crie uma nova <div> com id="pagina-minha-regua" class="page-content">
    //    e coloque todo o conteúdo (templates, fluxos, etc.) dentro dela.
    // 3. O menu será gerado automaticamente.
    // ================================================================
  </script>

</body>
