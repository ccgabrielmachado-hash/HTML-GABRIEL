    // ============================================================
    // FUNÇÕES AUXILIARES
    // ============================================================
    function nomeMes(mes) {
        const nomes = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
        const partes = mes.split('-');
        const ano = partes[0];
        const mesNum = parseInt(partes[1],10) - 1;
        return nomes[mesNum] + ' ' + ano;
    }

    // ============================================================
    // TOGGLE DOS DETALHES DAS CHAMADAS
    // ============================================================
    function toggleChamadas(stepElement, mes) {
        const detalhes = stepElement.querySelector('.chamadas-detalhes');
        if (detalhes) {
            detalhes.classList.toggle('open');
        }
    }

    // ============================================================
    // RENDERIZAÇÃO DO FUNIL WHATSAPP
    // ============================================================
    function renderizarFunilWhats(containerId, dados, panelIndex) {
        const container = document.getElementById(containerId);
        if (!container) return;
        const w = dados.whats;

        document.getElementById(`whatsBase${panelIndex}`).textContent = w.base.toLocaleString('pt-BR');
        document.getElementById(`whatsEnviadas${panelIndex}`).textContent = w.enviadas.toLocaleString('pt-BR');

        const steps = [
            { label: 'Mensagens Recebidas', value: w.recebidas, icon: 'recebidas', barClass: 'teal', percent: 100 },
            { label: 'Consultas', value: w.consultas, icon: 'consulta', barClass: 'green', percent: (w.recebidas > 0 ? (w.consultas / w.recebidas * 100) : 0), extra: `<span class="step-percent">${(w.recebidas > 0 ? (w.consultas / w.recebidas * 100).toFixed(1) : '0')}% das Mensagens Recebidas</span>` },
            { label: 'Exames', value: w.exames, icon: 'exame', barClass: 'amber', percent: (w.recebidas > 0 ? (w.exames / w.recebidas * 100) : 0), extra: `<span class="step-percent">${(w.recebidas > 0 ? (w.exames / w.recebidas * 100).toFixed(1) : '0')}% das Mensagens Recebidas</span>` },
            { label: 'Odontologia', value: w.odonto, icon: 'odonto', barClass: 'red', percent: (w.recebidas > 0 ? (w.odonto / w.recebidas * 100) : 0), extra: `<span class="step-percent">${(w.recebidas > 0 ? (w.odonto / w.recebidas * 100).toFixed(1) : '0')}% das Mensagens Recebidas</span>` },
            { label: 'Outros Assuntos', value: w.outros, icon: 'outros', barClass: 'orange', percent: (w.recebidas > 0 ? (w.outros / w.recebidas * 100) : 0), extra: `<span class="step-percent">${(w.recebidas > 0 ? (w.outros / w.recebidas * 100).toFixed(1) : '0')}% das Mensagens Recebidas</span>` },
            { label: 'Agendamentos', value: w.agendamentos, icon: 'agendamento', barClass: 'purple', percent: (w.recebidas > 0 ? (w.agendamentos / w.recebidas * 100) : 0), extra: `
                <span class="step-percent">${(w.recebidas > 0 ? (w.agendamentos / w.recebidas * 100).toFixed(1) : '0')}% das Mensagens Recebidas</span>
                <div class="step-split">
                    <span class="step-split-item"><span class="label"><i class="fa-regular fa-user"></i> Humano</span><span class="value">${w.agendHumano}</span></span>
                    <span class="step-split-item"><span class="label"><i class="fa-regular fa-robot"></i> Chatbot</span><span class="value">${w.agendBot}</span></span>
                </div>
            ` }
        ];

        const iconMap = {
            'recebidas':'fa-regular fa-inbox',
            'consulta':'fa-regular fa-stethoscope',
            'exame':'fa-regular fa-flask',
            'odonto':'fa-regular fa-tooth',
            'outros':'fa-regular fa-tag',
            'agendamento':'fa-regular fa-calendar-check'
        };

        container.innerHTML = steps.map(s => {
            const percent = Math.min(s.percent, 100);
            return `
                <div class="funnel-step">
                    <div class="step-icon ${s.icon}"><i class="${iconMap[s.icon]}"></i></div>
                    <div class="step-info">
                        <div class="step-label">${s.label}</div>
                        <div class="step-value">${s.value.toLocaleString('pt-BR')}</div>
                        ${s.extra || ''}
                        <div class="step-bar"><div class="bar-fill ${s.barClass}" style="width:${percent}%;"></div></div>
                    </div>
                </div>
            `;
        }).join('');
    }

// ============================================================
// RENDERIZAÇÃO DO FUNIL VOZ (com chamadas clicáveis)
// ============================================================
function renderizarFunilVoz(containerId, dados, mes) {
    const container = document.getElementById(containerId);
    if (!container) return;
    const v = dados.voz;
    const totalAgendamentos = v.agendamentos || 0;
    const pctConsulta = totalAgendamentos > 0 ? (v.agendaConsultas / totalAgendamentos * 100) : 0;
    const pctExame    = totalAgendamentos > 0 ? (v.agendaExames    / totalAgendamentos * 100) : 0;
    const pctOdonto   = totalAgendamentos > 0 ? (v.agendaOdonto    / totalAgendamentos * 100) : 0;

    // Busca as ligações direto do bloco voz
    const ligacoes1515 = v.ligacoes1515 || 0;
    const ligacoes6080 = v.ligacoes6080 || 0;

    const steps = [
        { 
            label: 'Chamadas Recebidas', 
            value: v.recebidas, 
            icon: 'phone-recebidas', 
            barClass: 'cyan', 
            percent: 100,
            clickable: true,
            ligacoes1515: ligacoes1515,
            ligacoes6080: ligacoes6080
        },
        { label: 'Atendidos', value: v.atendidas, icon: 'phone-atendidas', barClass: 'blue', percent: (v.recebidas > 0 ? (v.atendidas / v.recebidas * 100) : 0), extra: `<span class="step-percent">${(v.recebidas > 0 ? (v.atendidas / v.recebidas * 100).toFixed(1) : '0')}% das Chamadas Recebidas</span>` },
        { label: 'Agendamentos (total)', value: totalAgendamentos, icon: 'phone-agendamentos', barClass: 'purple', percent: (v.atendidas > 0 ? (totalAgendamentos / v.atendidas * 100) : 0), extra: `<span class="step-percent">${(v.atendidas > 0 ? (totalAgendamentos / v.atendidas * 100).toFixed(1) : '0')}% dos Atendidos</span>` },
        { label: 'Agendamentos Consulta', value: v.agendaConsultas || 0, icon: 'phone-consulta', barClass: 'green', percent: pctConsulta, extra: `<span class="step-percent">${pctConsulta.toFixed(1)}% do total de Agendamentos</span>` },
        { label: 'Agendamentos Exames', value: v.agendaExames || 0, icon: 'phone-exame', barClass: 'amber', percent: pctExame, extra: `<span class="step-percent">${pctExame.toFixed(1)}% do total de Agendamentos</span>` },
        { label: 'Agendamentos Odonto', value: v.agendaOdonto || 0, icon: 'phone-odonto', barClass: 'red', percent: pctOdonto, extra: `<span class="step-percent">${pctOdonto.toFixed(1)}% do total de Agendamentos</span>` },
        { label: 'Perda', value: v.perda, icon: 'phone-perda', barClass: 'red', percent: (v.recebidas > 0 ? (v.perda / v.recebidas * 100) : 0), extra: `
            <span class="step-percent">${(v.recebidas > 0 ? (v.perda / v.recebidas * 100).toFixed(1) : '0')}% das Chamadas Recebidas</span>
        ` }
    ];

    const iconMap = {
        'phone-recebidas':'fa-solid fa-phone-volume',
        'phone-atendidas':'fa-solid fa-headset',
        'phone-agendamentos':'fa-regular fa-calendar-check',
        'phone-consulta':'fa-regular fa-stethoscope',
        'phone-exame':'fa-regular fa-flask',
        'phone-odonto':'fa-regular fa-tooth',
        'phone-perda':'fa-solid fa-circle-xmark'
    };

    container.innerHTML = steps.map((s, index) => {
        const percent = Math.min(s.percent, 100);
        
        // Se for o primeiro (Chamadas Recebidas), monta com detalhes expansíveis
        if (index === 0) {
            return `
                <div class="funnel-step voice-step" onclick="toggleChamadas(this, '${mes}')">
                    <div class="step-main">
                        <div class="step-icon ${s.icon}"><i class="${iconMap[s.icon]}"></i></div>
                        <div class="step-info">
                            <div class="step-label">${s.label}</div>
                            <div class="step-value">${s.value.toLocaleString('pt-BR')}</div>
                            <span class="click-hint"><i class="fa-regular fa-hand-pointer"></i> Clique para ver detalhes</span>
                            <div class="step-bar"><div class="bar-fill ${s.barClass}" style="width:${percent}%;"></div></div>
                        </div>
                    </div>
                    <div class="chamadas-detalhes" id="detalhes-${mes}-${containerId}">
                        <div class="detalhe-item">
                            <span class="label"><i class="fa-regular fa-building"></i> Ligações 1515</span>
                            <span class="value">${s.ligacoes1515.toLocaleString('pt-BR')}</span>
                        </div>
                        <div class="detalhe-item">
                            <span class="label"><i class="fa-regular fa-clock"></i> Ligações 6080</span>
                            <span class="value">${s.ligacoes6080.toLocaleString('pt-BR')}</span>
                        </div>
                    </div>
                </div>
            `;
        }
        
        return `
            <div class="funnel-step voice-step">
                <div class="step-icon ${s.icon}"><i class="${iconMap[s.icon]}"></i></div>
                <div class="step-info">
                    <div class="step-label">${s.label}</div>
                    <div class="step-value">${s.value.toLocaleString('pt-BR')}</div>
                    ${s.extra || ''}
                    <div class="step-bar"><div class="bar-fill ${s.barClass}" style="width:${percent}%;"></div></div>
                </div>
            </div>
        `;
    }).join('');
}

