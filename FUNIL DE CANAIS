            .funnel-step .step-value { font-size: 18px; }
            .funnel-step .step-percent { font-size: 11px; padding: 1px 8px; }
            .funnel-step .step-split-item .value { font-size: 14px; }
            .tab-bar { flex-direction: column; border-radius: 14px; }
            .funnel-step .step-main { flex-wrap: wrap; gap: 10px; }
            .substeps-inline { font-size: 12px; gap: 4px 12px; }
            .chamadas-detalhes .detalhe-item { padding: 8px 12px; }
