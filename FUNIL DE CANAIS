    function atualizarPainel(tipo, panelIndex, mes) {
        if (tipo === 'clinicas') {
            renderizarFunilClinicas(`clinicasFunnel${panelIndex}`, mes);
            const el = document.getElementById(`clinicasTitle${panelIndex}`);
            if (el) el.textContent = nomeMes(mes) + (dadosClinicas[mes] ? '' : ' (sem dados)');
            return;
        }

        const dados = dadosMensais[mes];
        if (!dados) {
            const zero = {
                whats: { atendimentos: 0, agendamentos: 0, agendaConsultas: 0, agendaExames: 0, agendaOdonto: 0 },
                voz: { recebidas: 0, atendidas: 0, perda: 0, ligacoes1515: 0, ligacoes6080: 0, agendamentos: 0, agendaConsultas: 0, agendaExames: 0, agendaOdonto: 0 },
                site: { acessosTotal: 0, acessos: 0, iniciado: 0, agenda: 0, identificacao: 0, cadastro: 0, confirmado: 0, agendamentos: 0, agendaConsultas: 0, agendaExames: 0, agendaOdonto: 0 }
            };
            if (tipo === 'whats') { renderizarFunilWhats(`whatsappFunnel${panelIndex}`, zero); document.getElementById(`whatsTitle${panelIndex}`).textContent = nomeMes(mes) + ' (sem dados)'; }
            else if (tipo === 'voz') { renderizarFunilVoz(`vozFunnel${panelIndex}`, zero); document.getElementById(`vozTitle${panelIndex}`).textContent = nomeMes(mes) + ' (sem dados)'; }
            else if (tipo === 'site') { renderizarFunilSite(`siteFunnel${panelIndex}`, zero); document.getElementById(`siteTitle${panelIndex}`).textContent = nomeMes(mes) + ' (sem dados)'; }
            return;
        }
        if (tipo === 'whats') { renderizarFunilWhats(`whatsappFunnel${panelIndex}`, dados); document.getElementById(`whatsTitle${panelIndex}`).textContent = nomeMes(mes); }
        else if (tipo === 'voz') { renderizarFunilVoz(`vozFunnel${panelIndex}`, dados); document.getElementById(`vozTitle${panelIndex}`).textContent = nomeMes(mes); }
        else if (tipo === 'site') { renderizarFunilSite(`siteFunnel${panelIndex}`, dados); document.getElementById(`siteTitle${panelIndex}`).textContent = nomeMes(mes); }
    }

    function getMesesAtualEAnterior() {
        const hoje = new Date();
        const ano = hoje.getFullYear();
        const mes = hoje.getMonth();

        const atual = `${ano}-${String(mes + 1).padStart(2, '0')}`;

        let anoAnt = ano;
        let mesAnt = mes - 1;
        if (mesAnt < 0) { mesAnt = 11; anoAnt = ano - 1; }
        const anterior = `${anoAnt}-${String(mesAnt + 1).padStart(2, '0')}`;

        return { atual, anterior };
    }

    document.addEventListener('DOMContentLoaded', function() {
        const tabs = document.querySelectorAll('.tab-btn');
        const contents = document.querySelectorAll('.tab-content');
        tabs.forEach(tab => {
            tab.addEventListener('click', function() {
                tabs.forEach(t => t.classList.remove('active'));
                contents.forEach(c => c.classList.remove('active'));
                this.classList.add('active');
                const target = document.getElementById('tab-' + this.dataset.tab);
                if (target) target.classList.add('active');
            });
        });

        const wm1 = document.getElementById('whatsMonth1');
        const wm2 = document.getElementById('whatsMonth2');
        const vm1 = document.getElementById('vozMonth1');
        const vm2 = document.getElementById('vozMonth2');
        const sm1 = document.getElementById('siteMonth1');
        const sm2 = document.getElementById('siteMonth2');
        const cm1 = document.getElementById('clinicasMonth1');
        const cm2 = document.getElementById('clinicasMonth2');

        [wm1, wm2, vm1, vm2, sm1, sm2, cm1, cm2].forEach(el => { if (el) el.min = '2025-01'; });

        function setupSelector(selector, tipo, index) {
            selector.addEventListener('change', function() {
                const mes = this.value;
                if (mes) atualizarPainel(tipo, index, mes);
            });
        }
        setupSelector(wm1, 'whats', 1);    setupSelector(wm2, 'whats', 2);
        setupSelector(vm1, 'voz', 1);      setupSelector(vm2, 'voz', 2);
        setupSelector(sm1, 'site', 1);     setupSelector(sm2, 'site', 2);
        setupSelector(cm1, 'clinicas', 1); setupSelector(cm2, 'clinicas', 2);

        const { atual, anterior } = getMesesAtualEAnterior();

        wm1.value = anterior;  wm2.value = atual;
        vm1.value = anterior;  vm2.value = atual;
        sm1.value = anterior;  sm2.value = atual;
        cm1.value = anterior;  cm2.value = atual;

        atualizarPainel('whats', 1, anterior);
        atualizarPainel('whats', 2, atual);
        atualizarPainel('voz', 1, anterior);
        atualizarPainel('voz', 2, atual);
        atualizarPainel('site', 1, anterior);
        atualizarPainel('site', 2, atual);
        atualizarPainel('clinicas', 1, anterior);
        atualizarPainel('clinicas', 2, atual);

        const el = document.getElementById('ultimaAtualizacao');
        if (el) {
            const d = new Date();
            el.textContent = d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
        }
    });
</script>

</body>
</html>
