        .bar-fill.orange { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
        .bar-fill.pink { background: linear-gradient(90deg, #db2777, #f472b6); }
        .bar-fill.indigo { background: linear-gradient(90deg, #4f46e5, #818cf8); }
        .bar-fill.lime { background: linear-gradient(90deg, #65a30d, #a3e635); }

        .step-icon { width: 44px; height: 44px; border-radius: 14px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 18px; flex-shrink: 0; }
        .step-icon.atendimentos { background: #0d9488; }
        .step-icon.agendamento { background: #7c3aed; }
        .step-icon.consulta { background: #059669; }
        .step-icon.exame { background: #d97706; }
        .step-icon.odonto { background: #dc2626; }
        .step-icon.phone-recebidas { background: #0d9488; }
        .step-icon.phone-atendidas { background: #2563eb; }
        .step-icon.phone-agendamentos { background: #7c3aed; }
        .step-icon.phone-consulta { background: #059669; }
        .step-icon.phone-exame { background: #d97706; }
        .step-icon.phone-odonto { background: #dc2626; }
        .step-icon.phone-perda { background: #ef4444; }
        .step-icon.site-acessos { background: #3b82f6; }
        .step-icon.site-acessos-total { background: #6366f1; }
        .step-icon.site-iniciado { background: #8b5cf6; }
        .step-icon.site-agendamentos { background: #7c3aed; }

        .step-icon.clinica-total { background: #4f46e5; }
        .step-icon.clinica-blue { background: #3b82f6; }
        .step-icon.clinica-purple { background: #8b5cf6; }
        .step-icon.clinica-teal { background: #0d9488; }
        .step-icon.clinica-green { background: #059669; }
        .step-icon.clinica-amber { background: #d97706; }
        .step-icon.clinica-red { background: #dc2626; }
        .step-icon.clinica-cyan { background: #0891b2; }
        .step-icon.clinica-pink { background: #db2777; }
        .step-icon.clinica-indigo { background: #4f46e5; }

        .funnel-step.clinica-total { background: #eef2ff; border-color: #c7d2fe; }
        .funnel-step.clinica-total:hover { background: #e0e7ff; border-color: #a5b4fc; }

        .footer { margin-top: 36px; padding-top: 20px; border-top: 1px solid #e6edf4; display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: #5a6f8c; flex-wrap: wrap; gap: 12px; }
        .footer .source { display: flex; align-items: center; gap: 10px; }
        .footer .source img { height: 22px; width: auto; opacity: 0.6; }

        @media (max-width: 900px) {
            .comparison-grid { grid-template-columns: 1fr; gap: 24px; }
            .dashboard { padding: 24px 20px; }
            .funnel-step { padding: 12px 16px; gap: 14px; }
            .funnel-step .step-value { font-size: 20px; }
        }
        @media (max-width: 500px) {
            .dashboard { padding: 16px 12px; border-radius: 24px; }
