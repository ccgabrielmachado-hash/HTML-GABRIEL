    // ============================================================
    // ATUALIZAÇÃO DE UM PAINEL ESPECÍFICO
    // ============================================================
    function atualizarPainel(tipo, panelIndex, mes) {
        const dados = dadosMensais[mes];
        if (!dados) {
            const zero = {
                whats: {
                    base: 0,
                    enviadas: 0,
                    recebidas: 0,
                    consultas: 0,
                    exames: 0,
                    odonto: 0,
                    outros: 0,
                    agendamentos: 0,
                    agendHumano: 0,
                    agendBot: 0
                },
                voz: {
                    recebidas: 0,
                    atendidas: 0,
                    perda: 0,
                    agendamentos: 0,
                    agendaConsultas: 0,
                    agendaExames: 0,
                    agendaOdonto: 0,
                    ligacoes1515: 0,
                    ligacoes6080: 0
                }
            };
            if (tipo === 'whats') {
                renderizarFunilWhats(`whatsappFunnel${panelIndex}`, zero, panelIndex);
                document.getElementById(`whatsTitle${panelIndex}`).textContent = nomeMes(mes) + ' (sem dados)';
            } else {
                renderizarFunilVoz(`vozFunnel${panelIndex}`, zero, mes);
                document.getElementById(`vozTitle${panelIndex}`).textContent = nomeMes(mes) + ' (sem dados)';
            }
            return;
        }

        if (tipo === 'whats') {
            renderizarFunilWhats(`whatsappFunnel${panelIndex}`, dados, panelIndex);
            document.getElementById(`whatsTitle${panelIndex}`).textContent = nomeMes(mes);
        } else {
            renderizarFunilVoz(`vozFunnel${panelIndex}`, dados, mes);
            document.getElementById(`vozTitle${panelIndex}`).textContent = nomeMes(mes);
        }
    }

    // ============================================================
    // INICIALIZAÇÃO E EVENTOS
    // ============================================================
    document.addEventListener('DOMContentLoaded', function() {
        // Abas
        const tabs = document.querySelectorAll('.tab-btn');
        const contents = document.querySelectorAll('.tab-content');
        tabs.forEach(tab => {
            tab.addEventListener('click', function() {
                tabs.forEach(t => t.classList.remove('active'));
                contents.forEach(c => c.classList.remove('active'));
                this.classList.add('active');
                const target = document.getElementById('tab-' + this.dataset.tab);
                if (target) target.classList.add('active');
            });
        });

        // Seletores
        const wm1 = document.getElementById('whatsMonth1');
        const wm2 = document.getElementById('whatsMonth2');
        const vm1 = document.getElementById('vozMonth1');
        const vm2 = document.getElementById('vozMonth2');

        function setupSelector(selector, tipo, index) {
            selector.addEventListener('change', function() {
                const mes = this.value;
                if (mes) atualizarPainel(tipo, index, mes);
            });
        }

        setupSelector(wm1, 'whats', 1);
        setupSelector(wm2, 'whats', 2);
        setupSelector(vm1, 'voz', 1);
        setupSelector(vm2, 'voz', 2);

        // Renderização inicial
        atualizarPainel('whats', 1, '2026-06');
        atualizarPainel('whats', 2, '2026-07');
        atualizarPainel('voz', 1, '2026-06');
        atualizarPainel('voz', 2, '2026-07');
    });
</script>

