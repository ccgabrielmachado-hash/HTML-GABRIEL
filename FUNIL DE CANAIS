      ============================================================ -->
      <div id="pagina-visao-geral" class="page-content active">
        <h1>Ecossistema de Réguas</h1>
        <p class="subtitle">Visão das filas de processamento de dados ativos na clínica.</p>

        <!-- ============================================================
        STATUS DAS RÉGUAS — POR CATEGORIA
        ============================================================ -->
        <div style="background: white; border: 1px solid var(--card-border); padding: 20px; border-radius: 12px; margin-bottom: 24px;">
          <h3 style="font-size: 14px; margin-bottom: 18px; color: #0f172a;">⚙️ Status das Réguas</h3>

          <!-- ATRAÇÃO & CADASTRO -->
          <div style="margin-bottom: 20px;">
            <div style="font-size: 10px; text-transform: uppercase; color: var(--text-muted); font-weight: 700; letter-spacing: 0.5px; margin-bottom: 10px; padding-left: 2px;">📥 Atração & Cadastro</div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">

              <div style="border: 1px solid var(--card-border); border-radius: 10px; padding: 12px; display: flex; align-items: center; gap: 10px;">
                <div style="width: 8px; height: 8px; background: var(--success); border-radius: 50%; box-shadow: 0 0 0 3px rgba(34,197,94,0.15);"></div>
                <div style="flex: 1;">
                  <div style="font-size: 12px; font-weight: 700; color: #0f172a;">📧 E-mail: Boas-vindas</div>
                  <div style="font-size: 10px; color: var(--text-muted);">D+0 · E-mail</div>
                </div>
              </div>

            </div>
          </div>

          <!-- JORNADA AGENDAMENTO -->
          <div style="margin-bottom: 20px;">
            <div style="font-size: 10px; text-transform: uppercase; color: var(--text-muted); font-weight: 700; letter-spacing: 0.5px; margin-bottom: 10px; padding-left: 2px;">🗓 Jornada Agendamento</div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">

              <div style="border: 1px solid var(--card-border); border-radius: 10px; padding: 12px; display: flex; align-items: center; gap: 10px;">
                <div style="width: 8px; height: 8px; background: var(--success); border-radius: 50%; box-shadow: 0 0 0 3px rgba(34,197,94,0.15);"></div>
                <div style="flex: 1;">
                  <div style="font-size: 12px; font-weight: 700; color: #0f172a;">📧 1. Pré-Consulta</div>
                  <div style="font-size: 10px; color: var(--text-muted);">Imed. · E-mail</div>
                </div>
              </div>

              <div style="border: 1px solid var(--card-border); border-radius: 10px; padding: 12px; display: flex; align-items: center; gap: 10px;">
                <div style="width: 8px; height: 8px; background: var(--success); border-radius: 50%; box-shadow: 0 0 0 3px rgba(34,197,94,0.15);"></div>
                <div style="flex: 1;">
                  <div style="font-size: 12px; font-weight: 700; color: #0f172a;">💬 2. Confirmação</div>
                  <div style="font-size: 10px; color: var(--text-muted);">Dia 0 · WhatsApp</div>
                </div>
              </div>

              <div style="border: 1px solid var(--card-border); border-radius: 10px; padding: 12px; display: flex; align-items: center; gap: 10px;">
                <div style="width: 8px; height: 8px; background: var(--success); border-radius: 50%; box-shadow: 0 0 0 3px rgba(34,197,94,0.15);"></div>
                <div style="flex: 1;">
                  <div style="font-size: 12px; font-weight: 700; color: #0f172a;">📧 3. Pós-Consulta</div>
